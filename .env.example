# Copy to .env and fill in. Never commit .env.

# Production URL of the site (canonical URLs, Open Graph, sitemap)
SITE_URL=https://example.com

# Strapi CMS. Leave STRAPI_URL empty to use the bundled demo content in src/data/*.json.
STRAPI_URL=
# Optional read-only API token (Strapi admin → Settings → API Tokens). Server-side only.
STRAPI_API_TOKEN=

# Contact form endpoint (Formspree, Web3Forms, Basin, Getform or your own API).
# Leave empty for demo mode (the success message is shown, nothing is sent).
PUBLIC_FORM_ENDPOINT=
