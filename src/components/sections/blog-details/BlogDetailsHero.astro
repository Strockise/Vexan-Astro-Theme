---
import type { Blog } from '../../../lib/types';
import { renderRichText } from '../../../lib/utils';
import SectionSubtitle from '../../global/SectionSubtitle.astro';

interface Props {
  post: Blog;
}

const { post } = Astro.props;
---

<section class="section_blog-details">
  <div class="blog-details-gap">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="blog-details-wrapper">
        <div class="blog-detials-top-wrapper">
          <div class="blog-details-content-block">
            <div class="blog-details-header-block">
              <div page-load-1="" class="section-subtitle-block">
                <SectionSubtitle text="INSIGHTS & RESOURCES" />
              </div>
              <h1 heading-style-1="" class="heading-style-h1">{post.detailsTitle || post.title}</h1>
            </div>
            <div class="section-summary-block max-widht-24-rem">
              <p page-load-3="" class="bodyt-text-large text-color-gray-700">{post.detailsSummary || post.summary}</p>
            </div>
          </div>
          <div page-load-4="" class="blog-detials-image-block"><img src={post.thumbnailImage} loading="eager" fetchpriority="high" alt={post.title} class="blog-details-image" /></div>
        </div>
        <div class="blog-detials-bottom-wrapper">
          <div page-scroll-1="" class="section-subtitle-block">
            <SectionSubtitle text="OVERVIEW" />
          </div>
          <div class="blog-detials-wrap">
            <div scroll-list="" class="blog-info w-richtext" set:html={renderRichText(post.content)} />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
