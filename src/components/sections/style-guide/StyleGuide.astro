---
import PrimaryButton from '../../global/PrimaryButton.astro';
---

<section class="section-styleguide">
  <div class="styleguiede-sectin-gap">
    <div class="style-guide-gap">
      <div class="w-layout-blockcontainer container-main w-container">
        <div class="styleguide-wrapper">
          <div class="styleguide-header-block">
            <div class="section-header-block">
              <div heading-style-1="" class="heading-style-h1">Style Guide</div>
            </div>
            <div class="section-summary-block">
              <p page-load-3="" class="body-text-main">Explore the visual foundation behind PeakShield</p>
            </div>
          </div>
          <div class="styleguide-content-block">
            <div class="styleguide-content-wrapper">
              <div page-load-4="" class="styleyguide-title-block">
                <div class="styleguide-title">Color Palette</div>
              </div>
              <div page-load-5="" class="styleguide-color-grid">
                <div class="styleguide-color-card">
                  <div class="styleguide-color-block is-01"></div>
                  <div class="styleguide-color-content-block">
                    <div class="body-text-main text-color-black">Primary Color</div>
                    <div class="body-text-base">FF8F00</div>
                  </div>
                </div>
                <div class="styleguide-color-card">
                  <div class="styleguide-color-block is-02"></div>
                  <div class="styleguide-color-content-block">
                    <div class="body-text-main text-color-black">Gray 200</div>
                    <div class="body-text-base">#8f8f8f</div>
                  </div>
                </div>
                <div class="styleguide-color-card">
                  <div class="styleguide-color-block is-03"></div>
                  <div class="styleguide-color-content-block">
                    <div class="body-text-main text-color-black">Gray 300</div>
                    <div class="body-text-base">#d3d6da</div>
                  </div>
                </div>
                <div class="styleguide-color-card">
                  <div class="styleguide-color-block is-04"></div>
                  <div class="styleguide-color-content-block">
                    <div class="body-text-main text-color-black">Gray 500</div>
                    <div class="body-text-base">#f7f7f7</div>
                  </div>
                </div>
                <div class="styleguide-color-card">
                  <div class="styleguide-color-block is-05"></div>
                  <div class="styleguide-color-content-block">
                    <div class="body-text-main text-color-black">Gray 600</div>
                    <div class="body-text-base">#ffcd66</div>
                  </div>
                </div>
                <div class="styleguide-color-card">
                  <div class="styleguide-color-block is-06"></div>
                  <div class="styleguide-color-content-block">
                    <div class="body-text-main text-color-black">Black 400</div>
                    <div class="body-text-base">051627</div>
                  </div>
                </div>
                <div class="styleguide-color-card">
                  <div class="styleguide-color-block is-07"></div>
                  <div class="styleguide-color-content-block">
                    <div class="body-text-main text-color-black">Black Color</div>
                    <div class="body-text-base">0000</div>
                  </div>
                </div>
                <div class="styleguide-color-card">
                  <div class="styleguide-color-block is-08"></div>
                  <div class="styleguide-color-content-block">
                    <div class="body-text-main text-color-black">Gray 900</div>
                    <div class="body-text-base">#fb6319</div>
                  </div>
                </div>
                <div class="styleguide-color-card">
                  <div class="styleguide-color-block is-09"></div>
                  <div class="styleguide-color-content-block">
                    <div class="body-text-main text-color-black">White Color</div>
                    <div class="body-text-base">#ffffff</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="styleguide-content-block">
            <div scroll-list="" class="styleguide-content-wrapper">
              <div class="styleyguide-title-block">
                <div class="styleguide-title">Typography</div>
              </div>
              <div scroll-list="" class="styleguide-typography-block">
                <div class="styleguide-typography-wrapper">
                  <h1 class="heading-style-h1">Heading 1</h1>
                  <p class="body-text-base">Inter Tight • 4 Rem • 1.2 Line Height</p>
                </div>
                <div class="styleguide-typography-wrapper">
                  <h2 class="heading-style-2">Heading 2</h2>
                  <p class="body-text-base">Inter Tight • 4 Rem • 1.2 Line Height</p>
                </div>
                <div class="styleguide-typography-wrapper">
                  <h3 class="heading-style-3">Heading 3</h3>
                  <p class="body-text-base">Inter Tight • 2.5 Rem • 1.2 Line Height</p>
                </div>
                <div class="styleguide-typography-wrapper">
                  <h4 class="heading-style-4">Heading 4</h4>
                  <p class="body-text-base">Inter Tight • 2 Rem • 1.2 Line Height</p>
                </div>
                <div class="styleguide-typography-wrapper">
                  <h5 class="heading-style-5">Heading 5</h5>
                  <p class="body-text-base">Inter Tight • 1.75 Rem • 1.2 Line Height</p>
                </div>
                <div class="styleguide-typography-wrapper">
                  <h6 class="heading-style-6">Heading 6</h6>
                  <p class="body-text-base">Inter Tight • 1.5 Rem • 1.2 Line Height</p>
                </div>
                <div class="styleguide-typography-wrapper">
                  <p class="bodyt-text-large">Body 1</p>
                  <p class="body-text-base">Inter Tight • 1.25 Rem • 1.3 Line Height</p>
                </div>
                <div class="styleguide-typography-wrapper">
                  <div class="body-text-main text-color-black">Body 2</div>
                  <p class="body-text-base">Inter Tight • 1.125 Rem • 1.3 Line Height</p>
                </div>
                <div class="styleguide-typography-wrapper">
                  <div class="body-text-base text-color-black">Body 3</div>
                  <p class="body-text-base">Inter Tight • 0.875 Rem • 1.3 Line Height</p>
                </div>
                <div class="styleguide-typography-wrapper">
                  <div class="body-text-small text-color-black">Body 4</div>
                  <p class="body-text-base">Inter Tight • 0.75 Rem • 1.3 Line Height</p>
                </div>
              </div>
            </div>
          </div>
          <div class="styleguide-content-block">
            <div scroll-list="" class="styleguide-content-wrapper">
              <div class="styleyguide-title-block">
                <div class="styleguide-title">Button</div>
              </div>
              <div class="styleguide-typography-block">
                <div class="styleguidxe-button-block">
                  <PrimaryButton href="#" label="More About Us" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
