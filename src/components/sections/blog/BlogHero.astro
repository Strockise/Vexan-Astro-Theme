---
import { getBlogs } from '../../../lib/cms';
import BlogCard from '../../cards/BlogCard.astro';
import SectionSubtitle from '../../global/SectionSubtitle.astro';

const posts = await getBlogs();
---

<section class="section_blog-hero">
  <div class="w-layout-blockcontainer container-main w-container">
    <div class="blog-hero-wrapper">
      <div class="blog-hero-top-wrapper">
        <div class="blog-hero-header-block">
          <div page-load-1="" class="section-subtitle-block">
            <SectionSubtitle text="INSIGHTS & RESOURCES" />
          </div>
          <div class="section-header-block">
            <h1 heading-style-1="" class="heading-style-h1">Ideas, Strategies &amp; Digital Insights</h1>
          </div>
        </div>
        <div class="blog-hero-summary-block">
          <p page-load-3="" class="bodyt-text-large text-color-gray-700">Explore practical articles, industry trends, and expert perspectives on design, development, branding, and digital growth to help your business stay ahead.</p>
        </div>
      </div>
      <div class="blog-hero-content-wrapper">
        <div class="blog-cms-list-wrapper w-dyn-list">
          {
            posts.slice(0, 1).length > 0 ? (
              <div role="list" class="blog-cms-list w-dyn-items">
                {posts.slice(0, 1).map((post) => (
                  <div page-load-3="" role="listitem" class="blog-cms-item w-dyn-item">
                    <BlogCard post={post} variant="large" />
                  </div>
                ))}
              </div>
            ) : (
              <div class="w-dyn-empty">
                <div>No items found.</div>
              </div>
            )
          }
        </div>
        <div class="collection-list-wrapper w-dyn-list">
          {
            posts.slice(1, 2).length > 0 ? (
              <div role="list" class="blog-cms-list w-dyn-items">
                {posts.slice(1, 2).map((post) => (
                  <div page-load-3="" role="listitem" class="blog-cms-item w-dyn-item">
                    <BlogCard post={post} variant="small" />
                  </div>
                ))}
              </div>
            ) : (
              <div class="w-dyn-empty">
                <div>No items found.</div>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
