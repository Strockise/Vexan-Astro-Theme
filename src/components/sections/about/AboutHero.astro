---
import SectionSubtitle from '../../global/SectionSubtitle.astro';
---

<section class="section_about-hero">
  <div class="about-section-gap">
    <div class="w-layout-blockcontainer container-fluid w-container">
      <div class="about-hero-wrapper">
        <div class="about-hero-top-wrapper">
          <div class="about-hero-header">
            <div page-load-1="" class="section-subtitle-block">
              <SectionSubtitle text="ABOUT VEXAN®" />
            </div>
            <div class="section-header-block">
              <h1 heading-style-1="" class="heading-style-h1">Building Digital Experiences That Move Businesses Forward</h1>
            </div>
          </div>
          <div page-load-3="" class="about-hero-summary">
            <p class="bodyt-text-large text-color-gray-700">We&#x27;re a digital agency helping brands grow with strategic design, modern development, and great user experiences.</p>
          </div>
        </div>
        <div page-load-4="" class="about-hero-bottom-wrapper">
          <div class="about-image-flex">
            <div class="about-image-wrap">
              <div class="about-image-block"><img src="/images/About-Image-1-1.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-1-1-p-500.webp 500w, /images/About-Image-1-1-p-800.webp 800w, /images/About-Image-1-1.webp 1080w" alt="about-image" class="about-image"></div>
              <div class="about-image-block"><img src="/images/About-Image-2-1.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-2-1-p-500.webp 500w, /images/About-Image-2-1-p-800.webp 800w, /images/About-Image-2-1.webp 1080w" alt="about-image" class="about-image"></div>
              <div class="about-image-block"><img src="/images/About-Image-3-1.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-3-1-p-500.webp 500w, /images/About-Image-3-1-p-800.webp 800w, /images/About-Image-3-1.webp 1080w" alt="about-image" class="about-image"></div>
              <div class="about-image-block"><img src="/images/About-Image-1-1.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-1-1-p-500.webp 500w, /images/About-Image-1-1-p-800.webp 800w, /images/About-Image-1-1.webp 1080w" alt="about-image" class="about-image"></div>
              <div class="about-image-block"><img src="/images/About-Image-3-1.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-3-1-p-500.webp 500w, /images/About-Image-3-1-p-800.webp 800w, /images/About-Image-3-1.webp 1080w" alt="about-image" class="about-image"></div>
              <div class="about-image-block"><img src="/images/About-Image-2-1.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-2-1-p-500.webp 500w, /images/About-Image-2-1-p-800.webp 800w, /images/About-Image-2-1.webp 1080w" alt="about-image" class="about-image"></div>
            </div>
            <div class="about-image-wrap">
              <div class="about-image-block"><img src="/images/About-Image-1-1.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-1-1-p-500.webp 500w, /images/About-Image-1-1-p-800.webp 800w, /images/About-Image-1-1.webp 1080w" alt="about-image" class="about-image"></div>
              <div class="about-image-block"><img src="/images/About-Image-2-1.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-2-1-p-500.webp 500w, /images/About-Image-2-1-p-800.webp 800w, /images/About-Image-2-1.webp 1080w" alt="about-image" class="about-image"></div>
              <div class="about-image-block"><img src="/images/About-Image-3-1.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-3-1-p-500.webp 500w, /images/About-Image-3-1-p-800.webp 800w, /images/About-Image-3-1.webp 1080w" alt="about-image" class="about-image"></div>
              <div class="about-image-block"><img src="/images/About-Image-1-1.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-1-1-p-500.webp 500w, /images/About-Image-1-1-p-800.webp 800w, /images/About-Image-1-1.webp 1080w" alt="about-image" class="about-image"></div>
              <div class="about-image-block"><img src="/images/About-Image-3-1.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-3-1-p-500.webp 500w, /images/About-Image-3-1-p-800.webp 800w, /images/About-Image-3-1.webp 1080w" alt="about-image" class="about-image"></div>
              <div class="about-image-block"><img src="/images/About-Image-2-1.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-2-1-p-500.webp 500w, /images/About-Image-2-1-p-800.webp 800w, /images/About-Image-2-1.webp 1080w" alt="about-image" class="about-image"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
