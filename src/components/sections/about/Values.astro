---
import SectionSubtitle from '../../global/SectionSubtitle.astro';
---

<section class="section-values">
  <div class="values-bg-color">
    <div class="w-layout-blockcontainer container-main container-type w-container">
      <div class="values-sticky-container">
        <div class="values-wrapper">
          <div class="values-top-wrapper">
            <div class="values-header-wrapper">
              <div page-scroll-1="" class="section-subtitle-block">
                <SectionSubtitle text="Our Values" />
              </div>
              <h2 heading-style-2="" class="heading-style-h1">The Principles That Guide Everything We Do</h2>
            </div>
            <div class="values-summary-block">
              <p page-scroll-2="" class="bodyt-text-large text-color-gray-700">These values shape our culture, our work, and the relationships we build with clients.</p>
            </div>
          </div>
          <div class="values-sticky-block">
            <div page-scroll-3="" class="values-content-wrapper">
              <div class="values-card-flex">
                <div class="values-single-card">
                  <div class="values-image-wrap">
                    <div class="values-image-block"><img src="/images/Values-Image-1.webp" loading="lazy" sizes="100vw" srcset="/images/Values-Image-1-p-500.webp 500w, /images/Values-Image-1.webp 676w" alt="values-image" class="values-image"></div>
                  </div>
                  <div class="values-content-wrap">
                    <div class="values-card-title-block">
                      <h3 class="values-card-title">Excellence</h3>
                      <div class="body-text-main text-color-black-70">//01</div>
                    </div>
                    <div class="values-summary-wrap">
                      <p class="values-summary">We believe every detail matters and strive for quality in every project.</p>
                    </div>
                  </div>
                </div>
                <div class="values-single-card">
                  <div class="values-image-wrap">
                    <div class="values-image-block"><img src="/images/Values-Image-2.webp" loading="lazy" sizes="100vw" srcset="/images/Values-Image-2-p-500.webp 500w, /images/Values-Image-2.webp 676w" alt="values-image" class="values-image"></div>
                  </div>
                  <div class="values-content-wrap">
                    <div class="values-card-title-block">
                      <h3 class="values-card-title">Creativity</h3>
                      <div class="body-text-main text-color-black-70">//02</div>
                    </div>
                    <div class="values-summary-wrap">
                      <p class="values-summary">We challenge conventional thinking and create innovative solutions.</p>
                    </div>
                  </div>
                </div>
                <div class="values-single-card">
                  <div class="values-image-wrap">
                    <div class="values-image-block"><img src="/images/Values-Image-3.webp" loading="lazy" sizes="100vw" srcset="/images/Values-Image-3-p-500.webp 500w, /images/Values-Image-3.webp 676w" alt="values-image" class="values-image"></div>
                  </div>
                  <div class="values-content-wrap">
                    <div class="values-card-title-block">
                      <h3 class="values-card-title">Transparency</h3>
                      <div class="body-text-main text-color-black-70">//03</div>
                    </div>
                    <div class="values-summary-wrap">
                      <p class="values-summary">Clear communication and honest collaboration are at the heart of our process.</p>
                    </div>
                  </div>
                </div>
                <div class="values-single-card">
                  <div class="values-image-wrap">
                    <div class="values-image-block"><img src="/images/Values-Image-4.webp" loading="lazy" sizes="100vw" srcset="/images/Values-Image-4-p-500.webp 500w, /images/Values-Image-4.webp 676w" alt="values-image" class="values-image"></div>
                  </div>
                  <div class="values-content-wrap">
                    <div class="values-card-title-block">
                      <h3 class="values-card-title">Growth</h3>
                      <div class="body-text-main text-color-black-70">//04</div>
                    </div>
                    <div class="values-summary-wrap">
                      <p class="values-summary">We focus on delivering solutions that help businesses grow and evolve.</p>
                    </div>
                  </div>
                </div>
                <div class="values-single-card">
                  <div class="values-image-wrap">
                    <div class="values-image-block"><img src="/images/Values-Image-5.webp" loading="lazy" sizes="100vw" srcset="/images/Values-Image-5-p-500.webp 500w, /images/Values-Image-5.webp 676w" alt="values-image" class="values-image"></div>
                  </div>
                  <div class="values-content-wrap">
                    <div class="values-card-title-block">
                      <h3 class="values-card-title">Partnership</h3>
                      <div class="body-text-main text-color-black-70">//05</div>
                    </div>
                    <div class="values-summary-wrap">
                      <p class="values-summary">We work alongside our clients as an extension of their team.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
