---
import PrimaryButton from '../../global/PrimaryButton.astro';
import SectionSubtitle from '../../global/SectionSubtitle.astro';
---

<section class="section-about">
  <div class="section-gap">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="about-wrapper">
        <div class="about-left-wrapper">
          <div class="about-header-block">
            <div page-scroll-1="" class="section-subtitle-block">
              <SectionSubtitle text="Who We Are" />
            </div>
            <div class="section-header-block">
              <h2 heading-style-1="" class="heading-style-2">Vexan® was founded with a simple belief: great digital experiences create great business outcomes.</h2>
            </div>
          </div>
          <div class="about-content-wrapper">
            <div page-scroll-2="" class="about-summary-wrap">
              <p class="body-text-main text-color-black-70">We saw too many businesses struggling with outdated websites, unclear branding, and digital products that failed to connect with users. Our mission became clear—to help brands build meaningful digital experiences that not only look exceptional but also deliver measurable results.</p>
              <p class="body-text-main text-color-black-70">We saw too many businesses struggling with outdated websites, unclear branding, and digital products that failed to connect with users. Our mission became clear—to help brands build meaningful digital experiences that not only look exceptional but also deliver measurable results.</p>
            </div>
            <div page-scroll-3="" class="about-button-block">
              <PrimaryButton href="/contact" label="More About Us" />
            </div>
          </div>
        </div>
        <div class="about-right-wrapper">
          <div scroll-list="" class="about-image-grid">
            <div class="is-black"></div>
            <div class="about-image-block"><img src="/images/About-Image-1.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-1-p-500.webp 500w, /images/About-Image-1-p-800.webp 800w, /images/About-Image-1.webp 860w" alt="about-image-v1" class="about-image-v1"></div>
            <div class="about-image-block"><img src="/images/About-Image-2.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-2-p-500.webp 500w, /images/About-Image-2.webp 860w" alt="about-image-v1" class="about-image-v1"></div>
            <div class="about-image-block"><img src="/images/About-Image-3.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-3-p-500.webp 500w, /images/About-Image-3-p-800.webp 800w, /images/About-Image-3.webp 860w" alt="about-image-v1" class="about-image-v1"></div>
            <div class="about-image-block"><img src="/images/About-Image-4.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-4-p-500.webp 500w, /images/About-Image-4-p-800.webp 800w, /images/About-Image-4.webp 860w" alt="about-image-v1" class="about-image-v1"></div>
            <div class="is-black"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
