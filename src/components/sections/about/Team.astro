---
import SectionSubtitle from '../../global/SectionSubtitle.astro';
---

<section class="section-team">
  <div class="section-gap">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="team-wrapper">
        <div class="team-top-wrapper">
          <div page-scroll-1="" class="section-subtitle-block">
            <SectionSubtitle text="Our Team" />
          </div>
          <div class="section-header-block">
            <h2 heading-style-2="" class="team-header">Behind every successful project is a team passionate about creating exceptional digital experiences. We bring together diverse skills, fresh perspectives, and a shared commitment to helping businesses succeed online.</h2>
          </div>
        </div>
        <div class="team-content-wrapper">
          <div scroll-list="" class="team-content-grid">
            <div class="team-single-card">
              <div class="team-image-block"><img src="/images/Team-Image-1.webp" loading="lazy" sizes="100vw" srcset="/images/Team-Image-1-p-500.webp 500w, /images/Team-Image-1-p-800.webp 800w, /images/Team-Image-1.webp 851w" alt="team-image" class="team-image"></div>
              <div class="team-card-content">
                <h3 class="team-card-title">Evelyn Brooks</h3>
                <div class="team-card-text">Product Strategist</div>
              </div>
            </div>
            <div class="team-single-card">
              <div class="team-image-block"><img src="/images/Team-Image-2.webp" loading="lazy" sizes="100vw" srcset="/images/Team-Image-2-p-500.webp 500w, /images/Team-Image-2-p-800.webp 800w, /images/Team-Image-2.webp 851w" alt="team-image" class="team-image"></div>
              <div class="team-card-content">
                <h3 class="team-card-title">Jasper Lane</h3>
                <div class="team-card-text">Visual Designer</div>
              </div>
            </div>
            <div class="team-single-card">
              <div class="team-image-block"><img src="/images/Team-Image-3.webp" loading="lazy" sizes="100vw" srcset="/images/Team-Image-3-p-500.webp 500w, /images/Team-Image-3-p-800.webp 800w, /images/Team-Image-3.webp 851w" alt="team-image" class="team-image"></div>
              <div class="team-card-content">
                <h3 class="team-card-title">Liam Carter</h3>
                <div class="team-card-text">Interaction Designer</div>
              </div>
            </div>
            <div class="team-single-card">
              <div class="team-image-block"><img src="/images/Team-Image-4.webp" loading="lazy" sizes="100vw" srcset="/images/Team-Image-4-p-500.webp 500w, /images/Team-Image-4-p-800.webp 800w, /images/Team-Image-4.webp 851w" alt="team-image" class="team-image"></div>
              <div class="team-card-content">
                <h3 class="team-card-title">Sophia Grant</h3>
                <div class="team-card-text">Experience Architect</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
