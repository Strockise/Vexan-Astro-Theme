<section class="section-licenses">
  <div class="licenses-gap">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="licenses-wrapper">
        <div class="licenses-header-block">
          <h1 heading-style-1="" class="heading-style-h1">
            Licenses
          </h1>
          <p page-load-3="" class="licenses-summary">
            All graphical assets in this template are licensed for personal and commercial use. If you&#x27;d like to use a specific asset, please check the
            license below.
          </p>
        </div>
        <div load-stagger="delay" class="licenses-content-block">
          <div class="licenses-single-block">
            <div class="licenses-content-wrap">
              <div class="licenses-title-block">
                <div class="bodyt-text-large">Fonts</div>
              </div>
              <div class="licenses-content">
                <div class="licenses-title-details">
                  <div class="licenses-title-wrap">
                    <h2 class="licenses-title">Inter Tight</h2>
                  </div>
                  <p class="body-text-base">Our template features Inter Tight fonts, available for commercial use at no cost.</p>
                </div>
                <a href="https://fonts.google.com/specimen/Inter+Tight/license" target="_blank" class="licenses-link-block w-inline-block">
                  <div class="licenses-link-text">See Licenses</div>
                  <div class="licenses-link-icon w-embed">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <g clip-path="url(#clip0_432_1316)">
                        <path d="M5 12H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M15 16L19 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M15 8L19 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                      </g>
                      <defs>
                        <clipPath id="clip0_432_1316">
                          <rect width="24" height="24" fill="currentColor" />
                        </clipPath>
                      </defs>
                    </svg>
                  </div>
                </a>
              </div>
            </div>
          </div>
          <div class="licenses-single-block">
            <div class="licenses-content-wrap">
              <div class="licenses-title-block">
                <div class="bodyt-text-large">Images</div>
              </div>
              <div>
                <div class="licenses-content">
                  <div class="licenses-title-details">
                    <div class="licenses-title-wrap">
                      <h2 class="licenses-title">Pexels</h2>
                    </div>
                    <p class="body-text-base">Our template utilizes Pexels images, which can be used commercially without charge.</p>
                  </div>
                  <a href="https://www.pexels.com/license/" target="_blank" class="licenses-link-block w-inline-block">
                    <div class="licenses-link-text">See Licenses</div>
                    <div class="licenses-icon w-embed">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <g clip-path="url(#clip0_432_1316)">
                          <path d="M5 12H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                          <path d="M15 16L19 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                          <path d="M15 8L19 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </g>
                        <defs>
                          <clipPath id="clip0_432_1316">
                            <rect width="24" height="24" fill="currentColor" />
                          </clipPath>
                        </defs>
                      </svg>
                    </div>
                  </a>
                </div>
              </div>
            </div>
          </div>
          <div class="licenses-single-block">
            <div class="licenses-content-wrap">
              <div class="licenses-title-block">
                <div class="bodyt-text-large">Icon</div>
              </div>
              <div class="licenses-content">
                <div class="licenses-title-details">
                  <div class="licenses-title-wrap">
                    <h2 class="licenses-title">
                      <a href="https://hugeicons.com" target="_blank">
                        Hugeicons
                      </a>
                    </h2>
                  </div>
                  <p class="body-text-base">Our template use Hugeicons which is free for commercial use.</p>
                </div>
                <a href="https://hugeicons.com/license-agreement" target="_blank" class="licenses-link-block w-inline-block">
                  <div class="licenses-link-text">See Licenses</div>
                  <div class="licenses-icon w-embed">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <g clip-path="url(#clip0_432_1316)">
                        <path d="M5 12H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M15 16L19 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M15 8L19 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                      </g>
                      <defs>
                        <clipPath id="clip0_432_1316">
                          <rect width="24" height="24" fill="currentColor" />
                        </clipPath>
                      </defs>
                    </svg>
                  </div>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
