---
import PrimaryButton from '../../global/PrimaryButton.astro';
---

<div class="utility-page-wrapper">
  <div class="utility-page-content">
    <div load-stagger="rem" class="utility-page-content-block">
      <div class="utility-page-header-block">
        <h1 class="heading-style-h1">Oops... Page Not Found!</h1>
      </div>
      <div class="utility-image-block">
        <div class="not-found-text">
          4<span class="not-found-text-ht">0</span>4
        </div>
      </div>
      <div class="not-found-button-block">
        <PrimaryButton href="/" label="More About Us" />
      </div>
    </div>
  </div>
</div>
