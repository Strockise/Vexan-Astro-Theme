---
import { getBlogs } from '../../../lib/cms';
import BlogCard from '../../cards/BlogCard.astro';
import PrimaryButton from '../../global/PrimaryButton.astro';
import SectionSubtitle from '../../global/SectionSubtitle.astro';

const posts = await getBlogs();
---

<section class="section-blog">
  <div class="blog-gap">
    <div class="w-layout-blockcontainer container-main container-type w-container">
      <div class="blog-sticky-container">
        <div class="blog-wrapper-sticky">
          <div class="blog-top-wrapper">
            <div class="blog-header-block">
              <div page-scroll-1="" class="section-subtitle-block">
                <SectionSubtitle text="Blog" />
              </div>
              <div class="section-header-block max-width-54-rem">
                <h2 heading-style-2="" class="heading-style-h1">Ideas, Trends &amp; Strategies for Digital Growth</h2>
              </div>
            </div>
            <div page-scroll-2="" class="blog-button-wrap">
              <PrimaryButton href="/blog" label="View All Articles" />
            </div>
          </div>
          <div class="blog-sticky-block">
            <div page-scroll-3="" class="blog-content-wrapper">
              <div class="blog-content-wrap">
                <div class="blog-cms-wrapper is-small w-dyn-list">
                  {
                    posts.slice(0, 1).length > 0 ? (
                      <div role="list" class="blog-cms-list w-dyn-items">
                        {posts.slice(0, 1).map((post) => (
                          <div role="listitem" class="blog-cms-item w-dyn-item">
                            <BlogCard post={post} variant="home-small" />
                          </div>
                        ))}
                      </div>
                    ) : (
                      <div class="w-dyn-empty">
                        <div>No items found.</div>
                      </div>
                    )
                  }
                </div>
                <div class="blog-cms-wrapper is-large w-dyn-list">
                  {
                    posts.slice(1, 2).length > 0 ? (
                      <div role="list" class="blog-cms-list w-dyn-items">
                        {posts.slice(1, 2).map((post) => (
                          <div role="listitem" class="blog-cms-item w-dyn-item">
                            <BlogCard post={post} variant="home-large" />
                          </div>
                        ))}
                      </div>
                    ) : (
                      <div class="w-dyn-empty">
                        <div>No items found.</div>
                      </div>
                    )
                  }
                </div>
                <div class="blog-cms-wrapper is-small w-dyn-list">
                  {
                    posts.slice(2, 3).length > 0 ? (
                      <div role="list" class="blog-cms-list w-dyn-items">
                        {posts.slice(2, 3).map((post) => (
                          <div role="listitem" class="blog-cms-item w-dyn-item">
                            <BlogCard post={post} variant="home-small" />
                          </div>
                        ))}
                      </div>
                    ) : (
                      <div class="w-dyn-empty">
                        <div>No items found.</div>
                      </div>
                    )
                  }
                </div>
                <div class="blog-cms-wrapper is-large w-dyn-list">
                  {
                    posts.slice(3, 4).length > 0 ? (
                      <div role="list" class="blog-cms-list w-dyn-items">
                        {posts.slice(3, 4).map((post) => (
                          <div role="listitem" class="blog-cms-item w-dyn-item">
                            <BlogCard post={post} variant="home-large" />
                          </div>
                        ))}
                      </div>
                    ) : (
                      <div class="w-dyn-empty">
                        <div>No items found.</div>
                      </div>
                    )
                  }
                </div>
                <div class="blog-cms-wrapper is-small w-dyn-list">
                  {
                    posts.slice(4, 5).length > 0 ? (
                      <div role="list" class="blog-cms-list w-dyn-items">
                        {posts.slice(4, 5).map((post) => (
                          <div role="listitem" class="blog-cms-item w-dyn-item">
                            <BlogCard post={post} variant="home-small" />
                          </div>
                        ))}
                      </div>
                    ) : (
                      <div class="w-dyn-empty">
                        <div>No items found.</div>
                      </div>
                    )
                  }
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
