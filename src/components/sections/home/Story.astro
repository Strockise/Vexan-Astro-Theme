---
import PrimaryButton from '../../global/PrimaryButton.astro';
import SectionSubtitle from '../../global/SectionSubtitle.astro';
---

<section class="section_story">
  <div class="story-section-gap">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="story-wrapper">
        <div class="story-top-wrapper">
          <div page-scroll-1="" class="story-top-left">
            <SectionSubtitle text="Who We Are" />
          </div>
          <div class="story-top-right">
            <div class="story-content-block">
              <div class="story-summary-block">
                <h2 page-scroll-2="" class="story-summary">Vexan® _____ we believe great design should solve real problems. Our team works closely with clients to understand their goals, identify opportunities, and create solutions that improve user experience, strengthen brand presence, and increase conversions.</h2>
              </div>
              <div page-scroll-3="" class="story-button-block">
                <PrimaryButton href="/about" label="More About Us" />
              </div>
            </div>
          </div>
        </div>
        <div page-scroll-3="" class="story-bottom-wrapper">
          <div class="story-marque-text-block">
            <h3 class="story-marque-text">Your Creative Partner for Modern Digital Growth</h3>
          </div>
          <div class="story-marque-text-block">
            <h3 class="story-marque-text">Your Creative Partner for Modern Digital Growth</h3>
          </div>
        </div>
        <div page-scroll-2="" class="story-image-block"><img src="/images/Story-Image.webp" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 728px, 848px" srcset="/images/Story-Image-p-500.webp 500w, /images/Story-Image.webp 848w" alt="story-image" class="story-image"></div>
      </div>
    </div>
  </div>
</section>
