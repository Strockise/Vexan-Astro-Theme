HOST=0.0.0.0
PORT=1337

# Secrets: replace every value before deploying (e.g. `openssl rand -base64 32`)
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (SQLite by default; set DATABASE_CLIENT=postgres + DATABASE_URL in production)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Import the theme's demo content (../src/data + ../public/cms) on first start
SEED_DEMO_CONTENT=true

# Strapi MCP server at /mcp (for AI clients such as Claude Code)
MCP_ENABLED=true
