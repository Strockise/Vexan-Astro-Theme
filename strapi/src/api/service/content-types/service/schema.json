{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service",
    "description": "Services: home service cards and /service/[slug]"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "cardNumber": {
      "type": "string",
      "required": false
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "arrowIcon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "thumbnailImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "detailsTitle": {
      "type": "string",
      "required": false
    },
    "summaryTwo": {
      "type": "text",
      "required": false
    },
    "quickStats": {
      "type": "richtext"
    },
    "overview": {
      "type": "richtext"
    },
    "deliverables": {
      "type": "richtext"
    },
    "order": {
      "type": "integer",
      "default": 0,
      "required": true
    }
  }
}
